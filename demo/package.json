{
  "name": "hitbite-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "End-to-end demo runner for the HitBite testnet MVP (BUILD_PROMPT.md section 9).",
  "license": "MIT",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "demo": "tsx run.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "prettier --check . && tsc --noEmit"
  },
  "dependencies": {
    "viem": "2.56.5"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
