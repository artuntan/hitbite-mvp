# HitBite MVP — environment variables (testnet only; never a mainnet key)
# Copy to .env (root, used by Makefile/contracts/engine/demo) and web/.env.local (web).
# Every variable used anywhere in the repo is documented here. Leave secrets EMPTY in this file.

# ---------------------------------------------------------------------------
# Chain selection and RPC
# ---------------------------------------------------------------------------
# anvil | base-sepolia   (Avalanche Fuji 43113 is the documented fallback; not configured)
CHAIN=anvil
ANVIL_RPC_URL=http://127.0.0.1:8545
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Basescan (Sepolia) API key for `forge verify-contract` / `make verify`
BASESCAN_API_KEY=

# ---------------------------------------------------------------------------
# Keys (Base Sepolia). For Anvil, the Makefile injects Anvil's public default accounts.
# One key may hold every role for the MVP; separate keys are closer to production.
# ---------------------------------------------------------------------------
DEPLOYER_PRIVATE_KEY=
# Role holders granted by script/Deploy.s.sol (addresses; default to the deployer if empty)
ADMIN_ADDRESS=
REGISTRAR_ADDRESS=
ISSUER_ADDRESS=
ORACLE_ADDRESS=
# Signing keys used by the engine, the registrar worker and the demo runner
REGISTRAR_PRIVATE_KEY=
ISSUER_PRIVATE_KEY=
ORACLE_PRIVATE_KEY=
# Simulated attestor (engine/nav_engine/attest.py). An independent firm signs in production.
ATTESTOR_PRIVATE_KEY=

# Demo wallets for `make demo` (Section 9 of BUILD_PROMPT.md). Need a little testnet ETH.
DEMO_WALLET_A_PRIVATE_KEY=
DEMO_WALLET_B_PRIVATE_KEY=
DEMO_WALLET_C_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Engine (nav-engine compute | push | attest)
# ---------------------------------------------------------------------------
# RPC used by the engine to read totalSupply / nav and to send setNAV (no default; --rpc overrides)
NAV_ENGINE_RPC_URL=
# HBToken address. Give either the address directly or a deployment file; the file wins.
NAV_ENGINE_TOKEN_ADDRESS=
NAV_ENGINE_DEPLOYMENT=contracts/deployments/anvil.json
# Chain id, only needed when the RPC cannot be asked for it (--chain-id overrides)
NAV_ENGINE_CHAIN_ID=
# Signing keys are read from the environment above and from nowhere else:
#   ORACLE_PRIVATE_KEY    `nav-engine push`   - needs ORACLE_ROLE (DEFAULT_ADMIN_ROLE for --force)
#   ATTESTOR_PRIVATE_KEY  `nav-engine attest` - simulated attestor; an independent firm signs in production
# In CI they come from the protected `oracle` environment, never from a file.

# ---------------------------------------------------------------------------
# Web (copy the NEXT_PUBLIC_* and server-side values into web/.env.local)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CHAIN=anvil
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.basescan.org
# WalletConnect Cloud project id (RainbowKit). Injected wallets work without it; WalletConnect QR does not.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Verification-request store (libSQL). Local file by default; Turso URL + token on Vercel.
DATABASE_URL=file:./.data/hitbite.db
DATABASE_AUTH_TOKEN=
# Registrar worker: delay before testnet auto-approval, and a shared secret for the process endpoint
AUTO_APPROVE_DELAY_MS=10000
REGISTRAR_WORKER_SECRET=
# Server-side RPC for the events indexer (falls back to NEXT_PUBLIC_RPC_URL)
SERVER_RPC_URL=
