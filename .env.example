# Copy to .env at the repository root; dev/build/start/typecheck load it automatically.
# Phase 1 uses only public configuration. Later-phase variables are listed now
# so credentials can be provisioned without putting them in code or chat.
# Private keys must remain blank here. Never prefix a secret with NEXT_PUBLIC_.

# Selected network: arc-testnet (default), base-sepolia (fallback), local (31337).
NEXT_PUBLIC_CHAIN=arc-testnet
# Optional browser-safe HTTP(S) RPC; no embedded credentials or provider secrets.
# Blank selects the public RPC for the chosen network.
NEXT_PUBLIC_RPC_URL=""
# Optional private RPC override for server/tool processes (Phases 3–7).
RPC_URL=""
# Public app origin used for wallet metadata and verification challenges (Phase 5).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical landing origin. Change to https://hitbite.markets after DNS activation.
NEXT_PUBLIC_SITE_URL=https://hitbite-testnet-v2.vercel.app
# Launch-day switch: false hides testnet links/NAV and uses the access email.
NEXT_PUBLIC_APP_LIVE=true
# Public WalletConnect project ID; injected wallets do not require it (Phase 5).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""
# Expected public EVM address of the simulated attestor (Phases 4/6).
NEXT_PUBLIC_ATTESTOR_ADDRESS=""

# Funded testnet deployer key; deployment tools only (Phase 3).
DEPLOYER_PRIVATE_KEY=""
# Public AccessControl administrator address used at deployment (Phase 3).
ADMIN_ADDRESS=""
# Public intended issuer, oracle and registrar addresses (Phase 3).
ISSUER_ADDRESS=""
ORACLE_ADDRESS=""
REGISTRAR_ADDRESS=""
# Issuer signer for funding, E2E, and optional monthly coupons (Phases 3/7).
ISSUER_PRIVATE_KEY=""
# NAV publisher signer; Python job only (Phase 4).
ORACLE_PRIVATE_KEY=""
# Simulated verification signer; API server only (Phase 5).
REGISTRAR_PRIVATE_KEY=""
# Simulated attestor signer; NAV job only (Phase 4).
ATTESTOR_PRIVATE_KEY=""

# Server-only random secret (at least 32 characters) authenticating 5-minute review tickets.
VERIFICATION_SECRET=""

# Two distinct, funded testnet wallets used by the live runner (Phase 7).
E2E_WALLET_A_PRIVATE_KEY=""
# Second independent wallet; never reuse wallet A's key here.
E2E_WALLET_B_PRIVATE_KEY=""
# Exact app URL under test; use the live deployment for the Core gate (Phase 7).
E2E_BASE_URL=http://localhost:3000
# Positive decimal USDC amounts for each subscription and the total coupon test.
E2E_SUBSCRIBE_USDC=1
E2E_COUPON_USDC=0.2
# Optional separate funded test wallet for pnpm test:ui (never use an operator or E2E wallet).
UI_WALLET_PRIVATE_KEY=""
# Browser test URL; defaults to E2E_BASE_URL.
UI_BASE_URL=""

# Daily NAV is stale after this many hours (Phases 4/6/7).
NAV_MAX_AGE_HOURS=30

# Optional Base Sepolia explorer API key; Excellence fallback only.
BASESCAN_API_KEY=""
# Optional Vercel CLI/CI publishing credentials; unnecessary for Git integration.
VERCEL_TOKEN=""
VERCEL_ORG_ID=""
VERCEL_PROJECT_ID=""
# Optional local CI-evidence API credential; gh login can supply it (Phase 7).
# GitHub Actions supplies its own scoped GITHUB_TOKEN; never add it here.
GH_TOKEN=""

# GitHub Actions only: dedicated main-branch Vercel hook; treat its URL as a secret.
VERCEL_DEPLOY_HOOK=""
